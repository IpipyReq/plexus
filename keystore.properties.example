# Copy this file to keystore.properties (same folder) and fill it in.
# keystore.properties is in .gitignore, so your passwords never reach GitHub.
# storeFile is the full path to the key you made in Android Studio (Build > Generate Signed App Bundle / APK).
# Use forward slashes, e.g. C:/Users/you/keys/plexus.jks
storeFile=C:/path/to/plexus.jks
storePassword=
keyAlias=plexus
keyPassword=
